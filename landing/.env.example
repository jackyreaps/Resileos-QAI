# Public site (baked into index.html via config.js or meta — set at deploy)
RESILEOS_API_BASE_URL=https://api.yourdomain.dev/api/v1
RESILEOS_LANDING_ORIGIN=https://www.yourdomain.dev
RESILEOS_SITE_URL=http://127.0.0.1:8787

# Billing API
# Local runs use Stripe test mode. Leave the secret fields empty here and
# export the real values in your shell. Never commit .env or .env.live.
API_KEYS_PATH=./data/api_keys.json
FREE_KEY_RATE_PER_HOUR=5
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BUILDER=price_xxx
STRIPE_PRICE_FOUNDING_BUILDER=price_xxx
STRIPE_PRICE_TEAM=price_xxx
STRIPE_SUCCESS_URL=http://127.0.0.1:8787/?checkout=success
STRIPE_CANCEL_URL=http://127.0.0.1:8787/#pricing
# Optional Payment Link fallbacks (no backend checkout)
STRIPE_PAYMENT_LINK_BUILDER=
STRIPE_PAYMENT_LINK_TEAM=

# Pages sign-in. Set the real values in the Pages secret store, not in git.
# SESSION_SECRET=
# KEY_SEAL_SECRET=
# RESILEOS_PROXY_SECRET=
# EMAIL_FROM=login@resileosai.fun
# RESEND_API_KEY=
# EMAIL_API_URL=https://api.resend.com/emails
# CLOUDFLARE_EMAIL_API_TOKEN=
# MAGIC_LINK_TTL_SECONDS=900
# SESSION_TTL_SECONDS=1209600
# PASSWORD_PBKDF2_ITERATIONS=100000

# API host only (see HOSTING.md). Workers KV Storage Read.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_KV_NAMESPACE_ID=463f5f1f1d0a484fb3b9a8e79f0fc413
# RESILEOS_KV_CACHE_TTL=30
# RESILEOS_TRIAL_DAILY_LIMIT=20
